{{- $laptop := has (get . "machine") (list "framework" "thinkpad") -}}
// waybar for sway, in the Callie theme; icons need IosevkaTerm Nerd Font
// reference: `man 5 waybar` and the man page for each module
//
// The clock sits in the middle on the desktop's wide display, and ends the
// right side on the laptops, where that side runs too long for it to stay
// centered.
{
    "reload_style_on_change": true,
    "height": 34,
    "spacing": 0,
    "modules-left": [
        "tray",
        "sway/workspaces",
        "custom/recording",
        "custom/now-playing",
        "sway/mode",
        "sway/scratchpad"
    ],
{{- if not $laptop }}
    "modules-center": ["group/datetime"],
{{- end }}
    "modules-right": [
        "custom/dnd",
        "custom/notifications",
        "custom/night-light",
        "idle_inhibitor",
        "pulseaudio",
        "network",
        "bluetooth",
        "custom/hardware",
        "cpu",
        "memory",
        "custom/brightness",
        "battery"{{ if $laptop }},
        "group/datetime"{{ end }}
    ],

    "sway/mode": { "format": "{}" },
    "sway/scratchpad": {
        "format": " {count}",
        "show-empty": false,
        "tooltip-format": "{app}: {title}"
    },

    // the clock and the weather share one pill
    "group/datetime": {
        "orientation": "horizontal",
        "modules": ["clock", "custom/weather"]
    },
    "custom/weather": {
        "exec": "weather",
        "return-type": "json",
        "interval": 600,
        "on-click": "kitty --class weather weather forecast"
    },
    "clock": {
        "format": " {:%a %b %d  %I:%M %p}",
        "tooltip-format": "<tt><small>{calendar}</small></tt>",
        "calendar": {
            "mode": "month",
            "format": {
                "months": "<span color='#f08fb8'><b>{}</b></span>",
                "weekdays": "<span color='#82cdcd'><b>{}</b></span>",
                "today": "<span color='#f08fb8'><b><u>{}</u></b></span>"
            }
        }
    },

    // what's playing, from any MPRIS player (cliamp, browsers), shown only while
    // it plays; a click jumps to its window, a right-click pauses it, and
    // scrolling skips (script in ~/.bin)
    "custom/now-playing": {
        "exec": "now-playing",
        "return-type": "json",
        "interval": 2,
        "on-click": "now-playing focus",
        "on-click-right": "now-playing toggle",
        "on-scroll-up": "now-playing next",
        "on-scroll-down": "now-playing previous"
    },
    "custom/recording": {
        "exec": "screenrecord status",
        "return-type": "json",
        "interval": 5,
        "signal": 10,
        "on-click": "screenrecord stop"
    },
    "custom/dnd": {
        "exec": "dnd status",
        "return-type": "json",
        "interval": 30,
        "signal": 9,
        "on-click": "dnd"
    },
    "custom/notifications": {
        "exec": "notifications status",
        "return-type": "json",
        "interval": 30,
        "signal": 9,
        "on-click": "notifications"
    },
    "custom/night-light": {
        "exec": "night-light status",
        "return-type": "json",
        "interval": 60,
        "signal": 8,
        "on-click": "night-light toggle",
        "on-click-right": "night-light configure"
    },
    "idle_inhibitor": {
        "format": "{icon}",
        "format-icons": { "activated": "", "deactivated": "" },
        "tooltip-format-activated": "Staying awake",
        "tooltip-format-deactivated": "Idle as usual"
    },
    "pulseaudio": {
        "format": "{icon} {volume}%",
        "format-muted": "󰝟 muted",
        "format-bluetooth": " {volume}%",
        "format-icons": { "default": ["", "", ""] },
        "on-click": "pactl set-sink-mute @DEFAULT_SINK@ toggle"
    },
    "network": {
        "format-wifi": " {essid}",
        "format-ethernet": " wired",
        "format-disconnected": "󰖪 offline",
        "tooltip-format": "{ifname}: {ipaddr}/{cidr}",
        "on-click": "wifi-menu"
    },
    // the adapter and what's connected; a click opens the Bluetooth menu
    // (script in ~/.bin), and it hides where there's no adapter
    "bluetooth": {
        "format": "󰂯",
        "format-off": "󰂲",
        "format-disabled": "󰂲",
        "format-no-controller": "",
        "format-connected": "󰂱 {device_alias}",
        "format-connected-battery": "󰂱 {device_alias} {device_battery_percentage}%",
        "tooltip-format": "Bluetooth {status}",
        "tooltip-format-connected": "{num_connections} connected:\n{device_enumerate}",
        "tooltip-format-enumerate-connected": "{device_alias}",
        "tooltip-format-enumerate-connected-battery": "{device_alias}: {device_battery_percentage}%",
        "on-click": "bluetooth-menu"
    },
    "custom/hardware": {
        "exec": "hardware",
        "return-type": "json",
        "interval": 5,
        "on-click": "kitty --class hardware watch -n 2 sensors"
    },
    "cpu": { "format": " {usage}%", "interval": 5 },
    "memory": { "format": "󰍛 {percentage}%", "interval": 10 },
    // the laptop panel's or the desktop monitor's brightness, hidden where
    // there's neither; scroll to change it (script in ~/.bin)
    "custom/brightness": {
        "exec": "brightness status",
        "return-type": "json",
        "interval": 60,
        "signal": 11,
        "on-scroll-up": "brightness up",
        "on-scroll-down": "brightness down"
    },
    "battery": {
        "states": { "warning": 30, "critical": 15 },
        "format": "{icon} {capacity}%",
        "format-charging": " {capacity}%",
        "format-plugged": " {capacity}%",
        "format-icons": ["", "", "", "", ""],
        "tooltip-format": "{timeTo}"
    },
    "tray": { "spacing": 8 }
}
