// waybar for sway, in the Callie theme; icons need IosevkaTerm Nerd Font
// reference: `man 5 waybar` and the man page for each module
{
    "reload_style_on_change": true,
    "height": 34,
    "spacing": 0,
    "modules-left": ["tray", "sway/workspaces", "custom/recording", "sway/mode", "sway/scratchpad"],
    "modules-center": ["group/datetime"],
    "modules-right": [
        "custom/dnd",
        "custom/notifications",
        "custom/night-light",
        "idle_inhibitor",
        "pulseaudio",
        "network",
        "custom/hardware",
        "cpu",
        "memory",
        "backlight",
        "battery"
    ],

    "sway/mode": { "format": "{}" },
    "sway/scratchpad": {
        "format": " {count}",
        "show-empty": false,
        "tooltip-format": "{app}: {title}"
    },

    // the clock and the weather share one pill
    "group/datetime": {
        "orientation": "horizontal",
        "modules": ["clock", "custom/weather"]
    },
    "custom/weather": {
        "exec": "weather",
        "return-type": "json",
        "interval": 600,
        "on-click": "kitty --class weather weather forecast"
    },
    "clock": {
        "format": " {:%a %b %d  %I:%M %p}",
        "tooltip-format": "<tt><small>{calendar}</small></tt>",
        "calendar": {
            "mode": "month",
            "format": {
                "months": "<span color='#f08fb8'><b>{}</b></span>",
                "weekdays": "<span color='#82cdcd'><b>{}</b></span>",
                "today": "<span color='#f08fb8'><b><u>{}</u></b></span>"
            }
        }
    },

    "custom/recording": {
        "exec": "screenrecord status",
        "return-type": "json",
        "interval": 5,
        "signal": 10,
        "on-click": "screenrecord stop"
    },
    "custom/dnd": {
        "exec": "dnd status",
        "return-type": "json",
        "interval": 30,
        "signal": 9,
        "on-click": "dnd"
    },
    "custom/notifications": {
        "exec": "notifications status",
        "return-type": "json",
        "interval": 30,
        "signal": 9,
        "on-click": "notifications"
    },
    "custom/night-light": {
        "exec": "night-light status",
        "return-type": "json",
        "interval": 60,
        "signal": 8,
        "on-click": "night-light toggle",
        "on-click-right": "night-light configure"
    },
    "idle_inhibitor": {
        "format": "{icon}",
        "format-icons": { "activated": "", "deactivated": "" },
        "tooltip-format-activated": "Staying awake",
        "tooltip-format-deactivated": "Idle as usual"
    },
    "pulseaudio": {
        "format": "{icon} {volume}%",
        "format-muted": "󰝟 muted",
        "format-bluetooth": " {volume}%",
        "format-icons": { "default": ["", "", ""] },
        "on-click": "pactl set-sink-mute @DEFAULT_SINK@ toggle"
    },
    "network": {
        "format-wifi": " {essid}",
        "format-ethernet": " wired",
        "format-disconnected": "󰖪 offline",
        "tooltip-format": "{ifname}: {ipaddr}/{cidr}",
        "on-click": "wifi-menu"
    },
    "custom/hardware": {
        "exec": "hardware",
        "return-type": "json",
        "interval": 5,
        "on-click": "kitty --class hardware watch -n 2 sensors"
    },
    "cpu": { "format": " {usage}%", "interval": 5 },
    "memory": { "format": "󰍛 {percentage}%", "interval": 10 },
    "backlight": {
        "format": " {percent}%",
        "on-scroll-up": "brightnessctl set 5%+",
        "on-scroll-down": "brightnessctl set 5%-"
    },
    "battery": {
        "states": { "warning": 30, "critical": 15 },
        "format": "{icon} {capacity}%",
        "format-charging": " {capacity}%",
        "format-plugged": " {capacity}%",
        "format-icons": ["", "", "", "", ""],
        "tooltip-format": "{timeTo}"
    },
    "tray": { "spacing": 8 }
}
