{{- $machine := get . "machine" -}}
{{- $laptop := has $machine (list "framework" "thinkpad") -}}
# swayidle on this machine ({{ $machine }}), started by the sway config with
# `exec swayidle -w`
# reference: `man swayidle`

{{- if $laptop }}

# lock after 5 minutes idle, and suspend 5 minutes after that
timeout 300 'swaylock'
timeout 600 'systemctl suspend'
{{- else }}

# lock after 5 minutes idle, and turn the screens off 5 minutes after that
timeout 300 'swaylock'
timeout 600 'swaymsg "output * power off"' resume 'swaymsg "output * power on"'
{{- end }}

# lock before sleeping, so waking needs the password
before-sleep 'swaylock'
