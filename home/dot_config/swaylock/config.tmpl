{{- $machine := get . "machine" -}}
{{- $laptop := has $machine (list "framework" "thinkpad") -}}
{{- $wallpaper := "pond.jpg" -}}
{{- if $laptop }}{{ $wallpaper = "pond-laptop.jpg" }}{{ end -}}
# swaylock, in the Callie theme (https://github.com/greylocklabs/themes), over
# the same wallpaper as sway on this machine ({{ $machine }})
# reference: `man swaylock`; each line is a long option without its dashes

daemonize
{{- if $laptop }}
# no ignore-empty-password here: pressing Enter on an empty field is how a
# fingerprint unlock starts (see the fingerprint steps in docs/new-machine.md)
{{- else }}
ignore-empty-password
{{- end }}
show-failed-attempts
indicator-caps-lock

image={{ joinPath .chezmoi.homeDir ".local/share/wallpapers" $wallpaper }}
scaling=fill
color=1c1220

# show the ring before typing starts, so the screen reads as locked
indicator-idle-visible
font=IosevkaTerm Nerd Font
indicator-radius=90
indicator-thickness=10

inside-color=261a2ae6
inside-clear-color=261a2ae6
inside-caps-lock-color=261a2ae6
inside-ver-color=261a2ae6
inside-wrong-color=261a2ae6

ring-color=c9b7c6cc
ring-clear-color=d6ba86
ring-caps-lock-color=d6ba86
ring-ver-color=82cdcd
ring-wrong-color=e66e6d

line-color=00000000
line-clear-color=00000000
line-caps-lock-color=00000000
line-ver-color=00000000
line-wrong-color=00000000
separator-color=00000000

key-hl-color=f08fb8
caps-lock-key-hl-color=f08fb8
bs-hl-color=e66e6d
caps-lock-bs-hl-color=e66e6d

text-color=e0d3df
text-clear-color=d6ba86
text-caps-lock-color=d6ba86
text-ver-color=82cdcd
text-wrong-color=e66e6d
