{{- $wide := eq (get . "machine") "desktop" -}}
{{- $fedora := or (eq .chezmoi.osRelease.id "fedora") (contains "fedora" (.chezmoi.osRelease.idLike | default "")) -}}
# What sway sets up when it is the whole session, read at the end of config.
# sway-nested, which runs sway in a window under another desktop, leaves this
# out, since that desktop already does all of it.

# the distro's systemd session setup: the graphical session target, and the
# environment the portals and user services need
include /etc/sway/config.d/*

# a polkit agent, to answer apps that ask for your password
{{- if $fedora }}
exec /usr/libexec/kf6/polkit-kde-authentication-agent-1
{{- else }}
exec /usr/lib/polkit-gnome/polkit-gnome-authentication-agent-1
{{- end }}

# dark mode, for GTK apps and, through the portal, Flatpaks and browsers.
# Plasma themes GTK apps itself on KDE machines; elsewhere, use Adwaita's dark
# variant for GTK 3 apps, which ignore color-scheme.
exec gsettings set org.gnome.desktop.interface color-scheme prefer-dark
{{- if not .kde }}
exec gsettings set org.gnome.desktop.interface gtk-theme Adwaita-dark
{{- end }}

# night light, back on at login if it was on before (script in ~/.bin)
exec night-light restore

# the startup windows (script in ~/.bin), laid out for the ultrawide on the
# desktop
exec sway-startup{{ if $wide }} wide{{ end }}

# the desktop's autostart apps, such as Dropbox and KDE Connect, once waybar's
# tray is up for their icons (wait-for-tray in ~/.bin)
{{- if $fedora }}
exec wait-for-tray dex-autostart --autostart --environment sway
{{- else }}
exec wait-for-tray dex --autostart --environment sway
{{- end }}

# recoll's indexer, which waits for a graphical session target sway doesn't
# start
exec systemctl --user start recollindex.service
