# sway config
#
# author: @lararosekelley
# last modified: 2026-11-24
# reference: `man 5 sway`
#
# --------

# variables
# --------

# super key
set $mod Mod4

# vi keys (Mod-h = Mod-Left, etc)
set $left h
set $down j
set $up k
set $right l

# terminal
set $term kitty

# app launcher (depends on rofi installation)
set $menu "rofi -show combi -show-icons -combi-modes window,drun,run,ssh,filebrowser,keys"

# this machine
# --------

# Settings for one machine only (outputs, keys that differ between keyboards),
# which chezmoi writes from the `machine` answer at `chezmoi init`. Read here
# so it can change the variables above before anything below uses them.
include ~/.config/sway/machine.conf

# visuals
#
# reference: `man 5 sway-output`
# --------

# gap between windows, dropped when a workspace holds a single window
gaps inner 6
gaps outer 2
smart_gaps on

# border around windows, hidden when a workspace holds a single window
default_border pixel 2
default_floating_border pixel 2
smart_borders on

# title font, seen in tabbed and stacked layouts
font pango:IosevkaTerm Nerd Font 10

# window colors, from the Callie theme (https://github.com/greylocklabs/themes)
# class                 border  bg      text    indicator child_border
client.focused          #f08fb8 #f08fb8 #2e0f20 #e5aac1   #f08fb8
client.focused_inactive #3d2c42 #261a2a #c9b7c6 #3d2c42   #3d2c42
client.unfocused        #2c2031 #1c1220 #9a8797 #2c2031   #2c2031
client.urgent           #e66e6d #e66e6d #2e0f20 #e66e6d   #e66e6d
client.placeholder      #1c1220 #1c1220 #e0d3df #1c1220   #1c1220
client.background       #1c1220

# displays (see: swaymsg -t get_outputs) are set per machine, in machine.conf

# wallpaper
output * bg /usr/share/backgrounds/sway/Sway_Wallpaper_Blue_1920x1080.png fill

# input
#
# reference: `man 5 sway-input`
# --------

# laptop touchpads
input type:touchpad {
    dwt enabled
    tap enabled
    tap_button_map lrm
    click_method clickfinger
    clickfinger_button_map lrm
    natural_scroll enabled
    middle_emulation enabled
}

# keyboards
input type:keyboard {
    xkb_layout "us"
}

# sleep
# --------

# lock and blank the screen when idle, and lock before sleeping; the timings
# are in ~/.config/swayidle/config, and swaylock's look in its own config
exec swayidle -w

# keybindings
#
# - stick to defaults where they make sense
# - support vi keys
# - some overrides:
#   - "-" for horizontal
#   - "|" for vertical
#   - "\" for hor/ver toggle
#   - "x" for scratchpad
#   - "Space" for floating windows
#
# --------

# open application launcher
bindsym $mod+o exec $menu

# open terminal
bindsym $mod+Return exec $term

# kill focused window
bindsym $mod+q kill

# exit
bindsym $mod+shift+e exit

# $mod+<left mouse> to drag windows, $mod+<right mouse> to resize
floating_modifier $mod normal

# reload sway configuration file
bindsym $mod+shift+c reload

# move focus (vi and arrow keys)
bindsym $mod+$left focus left
bindsym $mod+$down focus down
bindsym $mod+$up focus up
bindsym $mod+$right focus right
bindsym $mod+Left focus left
bindsym $mod+Down focus down
bindsym $mod+Up focus up
bindsym $mod+Right focus right

# shift the position of the focused window
bindsym $mod+Shift+$left move left
bindsym $mod+Shift+$down move down
bindsym $mod+Shift+$up move up
bindsym $mod+Shift+$right move right
bindsym $mod+Shift+Left move left
bindsym $mod+Shift+Down move down
bindsym $mod+Shift+Up move up
bindsym $mod+Shift+Right move right

# change workspaces
bindsym $mod+1 workspace number 1
bindsym $mod+2 workspace number 2
bindsym $mod+3 workspace number 3
bindsym $mod+4 workspace number 4
bindsym $mod+5 workspace number 5
bindsym $mod+6 workspace number 6
bindsym $mod+7 workspace number 7
bindsym $mod+8 workspace number 8
bindsym $mod+9 workspace number 9
bindsym $mod+0 workspace number 10

# move focused container to workspace
bindsym $mod+Shift+1 move container to workspace number 1
bindsym $mod+Shift+2 move container to workspace number 2
bindsym $mod+Shift+3 move container to workspace number 3
bindsym $mod+Shift+4 move container to workspace number 4
bindsym $mod+Shift+5 move container to workspace number 5
bindsym $mod+Shift+6 move container to workspace number 6
bindsym $mod+Shift+7 move container to workspace number 7
bindsym $mod+Shift+8 move container to workspace number 8
bindsym $mod+Shift+9 move container to workspace number 9
bindsym $mod+Shift+0 move container to workspace number 10

# make the next split go horizontal or vertical
bindsym $mod+minus splith
bindsym $mod+bar splitv

# switch between vertical/horizontal split for next window
bindsym $mod+backslash layout toggle split

# windows in container stack on top of each other 
bindsym $mod+s layout stacking

# windows in container show up like browser tabs
bindsym $mod+t layout tabbed

# make the current focus fullscreen
bindsym $mod+f fullscreen

# toggle the current focus between tiling and floating mode
bindsym $mod+Shift+space floating toggle

# swap focus between the tiling area and the floating area
bindsym $mod+space focus mode_toggle

# move focus to the parent container
bindsym $mod+a focus parent

# switch to the last workspace, or the next or previous one on this output
bindsym $mod+Tab workspace back_and_forth
bindsym $mod+bracketright workspace next_on_output
bindsym $mod+bracketleft workspace prev_on_output

# show next window on the scratchpad
bindsym $mod+x scratchpad show

# move current window to scratchpad
bindsym $mod+Shift+x move scratchpad

# resize a window with left/right/up/down
mode "resize" {
    bindsym $left resize shrink width 10px
    bindsym $down resize grow height 10px
    bindsym $up resize shrink height 10px
    bindsym $right resize grow width 10px

    # Ditto, with arrow keys
    bindsym Left resize shrink width 10px
    bindsym Down resize grow height 10px
    bindsym Up resize shrink height 10px
    bindsym Right resize grow width 10px

    # Return to default mode
    bindsym Return mode "default"
    bindsym Escape mode "default"
}

bindsym $mod+r mode "resize"

# utility keybindings
# --------

# adjust volume with pulseaudio (pactl)
bindsym --locked XF86AudioMute exec pactl set-sink-mute \@DEFAULT_SINK@ toggle
bindsym --locked XF86AudioLowerVolume exec pactl set-sink-volume \@DEFAULT_SINK@ -5%
bindsym --locked XF86AudioRaiseVolume exec pactl set-sink-volume \@DEFAULT_SINK@ +5%
bindsym --locked XF86AudioMicMute exec pactl set-source-mute \@DEFAULT_SOURCE@ toggle

# control playback with playerctl (mpris-enabled playback utils)
bindsym --locked XF86AudioPlay exec playerctl play-pause
bindsym --locked XF86AudioPause exec playerctl play-pause
bindsym --locked XF86AudioPrev exec playerctl previous
bindsym --locked XF86AudioNext exec playerctl next
bindsym --locked XF86AudioStop exec playerctl stop

# adjust brightness via brightnessctl
bindsym --locked XF86MonBrightnessDown exec brightnessctl set 5%-
bindsym --locked XF86MonBrightnessUp exec brightnessctl set 5%+

# take a screenshot with grim
bindsym Print exec grim

# windows
# --------

# float dialogs and pop-ups instead of tiling them
for_window [window_role="pop-up"] floating enable
for_window [window_role="bubble"] floating enable
for_window [window_role="dialog"] floating enable
for_window [window_type="dialog"] floating enable
for_window [title="^(Open|Save)( (File|Files|Folder|As))?$"] floating enable
for_window [app_id="pavucontrol"] floating enable

# don't lock or blank the screen while a window is fullscreen, such as a video
for_window [app_id=".*"] inhibit_idle fullscreen
for_window [class=".*"] inhibit_idle fullscreen

# open sway config file in neovim floating window; the key that opens it is set
# per machine, in machine.conf
for_window [app_id="sway-config"] floating enable, resize set 800 600, move position center

# toggle network (script in ~/.bin, must be on PATH and executable)
bindsym --locked XF86RFKill exec airplane

# control various display settings: bound per machine, in machine.conf, since
# the display key differs between laptops

# status bar (via waybar)
#
# reference: `man 5 sway-bar`
bar {
    swaybar_command waybar
}

# the distro's systemd session setup, do not delete
include /etc/sway/config.d/*
