#!/usr/bin/env bash

# What's playing, for waybar: the artist and title from whichever MPRIS player
# (cliamp, a browser) is playing, and nothing while none is. A click jumps to
# the player's window, a right-click pauses it, and scrolling skips tracks.
#
# Usage: now-playing [status|focus|toggle|next|previous]
#
#   status  print waybar's JSON (the default)
#   focus   focus the window the playing player runs in

set -uo pipefail

# the first player that's playing
playing() {
  local player
  while IFS= read -r player; do
    [ "$(playerctl -p "$player" status 2> /dev/null)" = Playing ] \
      && echo "$player" && return 0
  done < <(playerctl -l 2> /dev/null)
  return 1
}

# the sway window the player runs in: the window of the player's process or
# its nearest ancestor (cliamp's terminal), else one whose app name holds the
# player's name, else one whose title holds the track's title; with several,
# the one whose title holds the track's title
window_of() {
  local player=$1 title=$2 tree pid ids
  tree=$(swaymsg -t get_tree)
  pid=$(busctl --user call org.freedesktop.DBus / org.freedesktop.DBus \
    GetConnectionUnixProcessID s "org.mpris.MediaPlayer2.$player" 2> /dev/null \
    | awk '{print $2}')
  while [ -n "$pid" ] && [ "$pid" -gt 1 ]; do
    ids=$(jq -r --argjson pid "$pid" --arg title "$title" '
      [.. | objects | select(.pid? == $pid)]
      | (map(select($title != "" and ((.name // "") | contains($title)))) + .)
      | .[0].id // empty' <<< "$tree")
    [ -n "$ids" ] && echo "$ids" && return 0
    pid=$(ps -o ppid= -p "$pid" 2> /dev/null | tr -d ' ')
  done
  jq -r --arg name "${player%%.*}" --arg title "$title" '
    [.. | objects | select(.pid? and .pid > 0)]
    | (map(select((.app_id // .window_properties.class // "") | ascii_downcase
        | contains($name | ascii_downcase)))
       + map(select($title != "" and ((.name // "") | contains($title)))))
    | .[0].id // empty' <<< "$tree" | grep . || return 1
}

case "${1:-status}" in
  status)
    if ! player=$(playing); then
      echo '{"text": ""}'
      exit 0
    fi
    artist=$(playerctl -p "$player" metadata artist 2> /dev/null)
    title=$(playerctl -p "$player" metadata title 2> /dev/null)
    jq -cn --arg player "${player%%.*}" --arg artist "$artist" --arg title "$title" '
      ([$artist, $title] | map(select(. != "")) | join(" - ")) as $now
      | (if $now == "" then $player else $now end) as $now
      | {
          text: ("󰎈 " + (if ($now | length) > 40 then $now[:39] + "…" else $now end) | @html),
          tooltip: ("\($player): \($now)" | @html),
          class: "playing"
        }'
    ;;
  focus)
    player=$(playing) || exit 0
    title=$(playerctl -p "$player" metadata title 2> /dev/null)
    if id=$(window_of "$player" "$title"); then
      swaymsg -q "[con_id=$id] focus"
    else
      notify-send -t 4000 "Can't find the window playing" "${player%%.*}"
    fi
    ;;
  toggle | next | previous)
    player=$(playing) || exit 0
    case "$1" in
      toggle) playerctl -p "$player" play-pause ;;
      *) playerctl -p "$player" "$1" ;;
    esac
    ;;
  -h | --help) sed -n '3,10p' "$0" | sed 's/^# \{0,1\}//' ;;
  *)
    echo "unknown argument: $1" >&2
    exit 2
    ;;
esac
