#!/usr/bin/env bash

# What D-Bus starts when an app asks for saved passwords (the secrets service,
# org.freedesktop.secrets) before anything provides it; see
# ~/.local/share/dbus-1/services/org.freedesktop.secrets.service, which takes
# the place of gnome-keyring's own.
#
# Where KDE's wallet is installed, it waits for the wallet to take the service:
# D-Bus then hands the waiting request to the wallet. Under sway, apps start
# before the wallet has registered, and without this gnome-keyring would take
# the service and stand in for the wallet with an empty keyring. Where there's
# no KDE wallet, or it never comes, it starts gnome-keyring as before.
#
# SECRETS_SERVICE_WAIT sets how many tenths of a second to wait, for tests.

set -uo pipefail

owned() {
  busctl --user call org.freedesktop.DBus /org/freedesktop/DBus \
    org.freedesktop.DBus NameHasOwner s org.freedesktop.secrets 2> /dev/null \
    | grep -q '^b true'
}

if command -v ksecretd > /dev/null; then
  for _ in $(seq 1 "${SECRETS_SERVICE_WAIT:-150}"); do
    owned && exit 0
    sleep 0.1
  done
fi

command -v gnome-keyring-daemon > /dev/null || exit 1
exec gnome-keyring-daemon --start --foreground --components=secrets
