#!/usr/bin/env python3
"""List the manual setup steps still to do on this machine.

Reads manual-steps.toml from the dotfiles repo (found through chezmoi), runs
each check for this machine and distro, and lists what's left with what it's
needed for, how to do it, and where the docs explain it. Steps no command can
check are listed for you to confirm. Exits 1 while anything is left to do.

Exits 2 when it can't tell which machine this is.

Usage: dotfiles-doctor [--all] [--machine NAME] [--distro fedora|arch]

  --all      also list the steps that are done or don't apply here
  --machine  check as another machine (desktop, framework, thinkpad)
  --distro   check as another distro
"""

import argparse
import os
import re
import subprocess
import sys
import tomllib
from pathlib import Path

TIMEOUT = 15


def repo_root():
    if os.environ.get("DOTFILES_REPO"):
        return Path(os.environ["DOTFILES_REPO"])
    source = subprocess.run(
        ["chezmoi", "source-path"], capture_output=True, text=True, check=True
    ).stdout.strip()
    top = subprocess.run(
        ["git", "-C", source, "rev-parse", "--show-toplevel"],
        capture_output=True,
        text=True,
        check=True,
    ).stdout.strip()
    return Path(top)


def this_machine():
    try:
        result = subprocess.run(
            ["chezmoi", "execute-template", "{{ .machine }}"],
            capture_output=True,
            text=True,
        )
    except OSError:
        return ""
    return result.stdout.strip() if result.returncode == 0 else ""


def this_distro():
    try:
        text = Path("/etc/os-release").read_text()
    except OSError:
        return ""
    fields = {}
    for line in text.splitlines():
        key, _, value = line.partition("=")
        fields[key] = value.strip().strip('"')
    names = [fields.get("ID", "")] + fields.get("ID_LIKE", "").split()
    for distro in ("fedora", "arch"):
        if distro in names:
            return distro
    return fields.get("ID", "")


def run(command, repo, env):
    try:
        result = subprocess.run(
            ["bash", "-c", command],
            cwd=repo,
            env=env,
            stdin=subprocess.DEVNULL,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            timeout=TIMEOUT,
        )
    except subprocess.TimeoutExpired:
        return None
    return result.returncode == 0


def status(step, repo, env, machine, distro):
    """One of: elsewhere, skipped, done, todo, confirm, timeout."""
    if "machines" in step and machine not in step["machines"]:
        return "elsewhere"
    if "distro" in step and step["distro"] != distro:
        return "elsewhere"
    if "when" in step and not run(step["when"], repo, env):
        return "skipped"
    if "check" not in step:
        return "confirm"
    done = run(step["check"], repo, env)
    if done is None:
        return "timeout"
    return "done" if done else "todo"


class Colors:
    def __init__(self, on):
        self.on = on

    def __call__(self, code, text):
        return f"\033[{code}m{text}\033[0m" if self.on else text


def main():
    parser = argparse.ArgumentParser(
        description="List the manual setup steps still to do on this machine."
    )
    parser.add_argument("--all", action="store_true")
    parser.add_argument("--machine")
    parser.add_argument("--distro")
    args = parser.parse_args()

    repo = repo_root()
    steps = tomllib.loads((repo / "manual-steps.toml").read_text())["step"]
    machine = args.machine or this_machine()
    if not machine:
        print(
            "dotfiles-doctor: can't tell which machine this is; run `chezmoi init`,"
            " or pass --machine",
            file=sys.stderr,
        )
        return 2
    distro = args.distro or this_distro()
    env = {**os.environ, "MACHINE": machine, "DISTRO": distro}
    color = Colors(sys.stdout.isatty() and "NO_COLOR" not in os.environ)

    marks = {
        "todo": color("31", "[todo]"),
        "timeout": color("31", "[todo]"),
        "confirm": color("33", "[ ?? ]"),
        "done": color("32", "[ ok ]"),
        "skipped": color("2", "[skip]"),
        "elsewhere": color("2", "[ -- ]"),
    }
    print(f"dotfiles-doctor: {machine or 'unknown machine'} ({distro or '?'})\n")

    counts = {}
    for step in steps:
        state = status(step, repo, env, machine, distro)
        counts[state] = counts.get(state, 0) + 1
        if state in ("done", "skipped", "elsewhere") and not args.all:
            continue
        print(f"{marks[state]} {step['title']}")
        if state in ("todo", "timeout", "confirm"):
            print(f"       needed for: {step['needed_for']}")
            if state == "timeout":
                print(f"       its check took over {TIMEOUT} seconds")
            if "fix" in step:
                print(f"       fix: {expand(step['fix'], env)}")
            print(f"       docs: {step['docs']}")

    left = counts.get("todo", 0) + counts.get("timeout", 0)
    summary = [
        f"{left} to do",
        f"{counts.get('confirm', 0)} to confirm yourself",
        f"{counts.get('done', 0)} done",
    ]
    hidden = counts.get("skipped", 0) + counts.get("elsewhere", 0)
    if hidden:
        summary.append(f"{hidden} not for this machine")
    print(
        ("\n" if left or counts.get("confirm") or args.all else "") + ", ".join(summary)
    )
    return 1 if left else 0


def expand(text, env):
    """Expand $NAME and ${NAME} from env, leaving unknown names alone."""

    def value(match):
        name = match.group(1) or match.group(2)
        return env.get(name, match.group(0))

    return re.sub(r"\$(\w+)|\$\{(\w+)\}", value, text)


if __name__ == "__main__":
    sys.exit(main())
