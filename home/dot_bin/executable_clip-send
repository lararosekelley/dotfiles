#!/usr/bin/env bash

# Send the clipboard, or with --stdin what's piped in, to another device on
# the tailnet with Taildrop. clip-receive on that device puts it on its
# clipboard. Text and images both work. Without a device, it's the only one
# Taildrop can reach, or one picked from them.
#
# Usage: clip-send [--stdin] [device]

set -uo pipefail

from_stdin=false
case "${1:-}" in
  -h | --help)
    echo "usage: clip-send [--stdin] [device]"
    exit 0
    ;;
  --stdin)
    from_stdin=true
    shift
    ;;
esac

notify() { notify-send -t 3000 "$@" 2> /dev/null || printf '%s\n' "$*" >&2; }

device=${1:-}
if [ -z "$device" ]; then
  targets=$(tailscale file cp --targets 2> /dev/null | awk '{print $2}')
  case "$(grep -c . <<< "$targets")" in
    0)
      notify "No device to send to" "Taildrop can't reach any of your machines"
      exit 1
      ;;
    1) device=$targets ;;
    *) device=$(rofi -dmenu -i -p "send clipboard to" <<< "$targets") || exit 0 ;;
  esac
  [ -n "$device" ] || exit 0
fi

clip=$(mktemp)
trap 'rm -f "$clip"' EXIT
if $from_stdin; then
  cat > "$clip"
else
  wl-paste > "$clip" 2> /dev/null
fi
if [ ! -s "$clip" ]; then
  notify "Nothing to send" "The clipboard is empty"
  exit 1
fi

case "$(file -b --mime-type "$clip")" in
  image/*) extension=png ;;
  *) extension=txt ;;
esac
# clip-receive recognizes a clip by this name; anything else is a plain file
name="clipboard-$(hostname)-$(date +%Y%m%d-%H%M%S).$extension"

if tailscale file cp --name "$name" - "$device:" < "$clip" > /dev/null; then
  notify "Clipboard sent to $device"
else
  notify "Couldn't send the clipboard to $device"
  exit 1
fi
