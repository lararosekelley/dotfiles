{{- $kde := promptBoolOnce . "kde" "Install the KDE settings (kwin rules, power profile, Discover launcher)" (contains "kde" (lower (env "XDG_CURRENT_DESKTOP"))) -}}
{{- $machines := list "framework" "thinkpad" "desktop" -}}
{{- $machine := "" -}}
{{- if has .chezmoi.hostname $machines -}}
{{-   $machine = promptChoiceOnce . "machine" "Machine, for per-machine settings" $machines .chezmoi.hostname -}}
{{- else -}}
{{-   $machine = promptChoiceOnce . "machine" "Machine, for per-machine settings" $machines -}}
{{- end -}}
sourceDir = {{ .chezmoi.workingTree | quote }}

[data]
  kde = {{ $kde }}
  machine = {{ $machine | quote }}

# `chezmoi merge` opens nvim's diff mode; chezmoi's default, vimdiff, isn't
# installed
[merge]
  command = "nvim"
  args = ["-d", {{ "{{ .Destination }}" | quote }}, {{ "{{ .Source }}" | quote }}, {{ "{{ .Target }}" | quote }}]
