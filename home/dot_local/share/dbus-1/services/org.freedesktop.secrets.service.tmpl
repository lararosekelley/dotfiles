# The secrets service (saved passwords) for apps that ask before anything
# provides it: KDE's wallet where it's installed, waited for, and gnome-keyring
# otherwise (script in ~/.bin). This takes the place of gnome-keyring's own file
# in /usr/share/dbus-1/services.
[D-BUS Service]
Name=org.freedesktop.secrets
Exec={{ joinPath .chezmoi.homeDir ".bin/secrets-service" }}
