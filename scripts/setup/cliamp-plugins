#!/usr/bin/env bash
#
# Install the cliamp plugins in cliamp-plugins.txt that aren't installed,
# approving each as it's installed. A plugin that's installed at another version
# is left alone, with a warning saying how to update it.
#
# chezmoi runs this on apply (see home/run_onchange_after_55-cliamp-plugins.sh.tmpl);
# it is also safe to run by hand.
#
# Usage: scripts/setup/cliamp-plugins [--dry-run]
#
# SETUP_CLIAMP_PLUGINS points at another list, for tests.

set -uo pipefail

here=$(dirname "$0")
# shellcheck source=scripts/setup/lib.sh
. "$here/lib.sh"

usage() { echo "usage: scripts/setup/cliamp-plugins [--dry-run]"; }

parse_args "$@"

if ! command -v cliamp > /dev/null 2>&1; then
  warn "cliamp is missing; install it (see docs/packages.md), then run this again"
  finish
fi

# installed plugins as "name version" lines
installed=$(cliamp plugins list 2> /dev/null | awk 'NR > 1 && NF >= 3 { print $1, $3 }')

present=0
while read -r name source; do
  case "$name" in "" | "#"*) continue ;; esac
  version=${source##*@v}
  [ "$version" = "$source" ] && version=""
  have=$(awk -v n="$name" '$1 == n { print $2 }' <<< "$installed")
  if [ -z "$have" ]; then
    run cliamp plugins install --yes "$source"
  elif [ -n "$version" ] && [ "$have" != "$version" ]; then
    warn "cliamp plugin $name is $have, not $version; update it with: cliamp plugins install --yes $source"
  else
    present=$((present + 1))
  fi
done < "${SETUP_CLIAMP_PLUGINS:-$here/cliamp-plugins.txt}"

[ "$present" -gt 0 ] && say "cliamp plugins: $present already installed"
finish
