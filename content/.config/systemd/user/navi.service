[Unit]
Description=navi: focused PR-review alerts
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart="%h/.local/bin/navi" run --config "%h/.config/navi/config.toml"
EnvironmentFile=-%h/.config/navi/navi.env
Restart=on-failure
RestartSec=10

[Install]
WantedBy=default.target
