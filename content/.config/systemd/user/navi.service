[Unit]
Description=navi: focused PR-review alerts
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart="/home/lara/.local/bin/navi" run --config "/home/lara/.config/navi/config.toml"
EnvironmentFile=-/home/lara/.config/navi/navi.env
Restart=on-failure
RestartSec=10

[Install]
WantedBy=default.target
