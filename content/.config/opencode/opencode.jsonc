{
  "$schema": "https://opencode.ai/config.json",
  "model": "openai/gpt-6-astra",
  "autoupdate": true,
  "mcp": {
    "playwright": {
      "type": "local",
      "command": ["npx", "-y", "@playwright/mcp@latest", "--extension"],
      "enabled": true,
    },
    "posthog": {
      "type": "remote",
      "enabled": true,
      "url": "https://mcp.posthog.com/mcp",
    },
    "circleci": {
      "type": "remote",
      "enabled": true,
      "url": "https://mcp.circleci.com/v1/mcp",
    },
    "magic-patterns": {
      "type": "remote",
      "enabled": true,
      "url": "https://mcp.magicpatterns.com/mcp",
    },
    "codspeed": {
      "type": "remote",
      "enabled": true,
      "url": "https://mcp.codspeed.io/mcp",
    },
    "linear": {
      "type": "remote",
      "enabled": true,
      "url": "https://mcp.linear.app/mcp",
    },
    "notion": {
      "type": "remote",
      "enabled": true,
      "url": "https://mcp.notion.com/mcp",
    },
    "github": {
      "type": "remote",
      "enabled": true,
      "url": "https://api.githubcopilot.com/mcp",
      "oauth": {
        "clientId": "{env:GITHUB_OPENCODE_CLIENT_ID}",
        "clientSecret": "{env:GITHUB_OPENCODE_CLIENT_SECRET}",
        "scope": "tools:read tools:execute",
      },
    },
    "sentry": {
      "type": "remote",
      "enabled": true,
      "url": "https://mcp.sentry.dev/mcp",
      "oauth": {},
    },
    "datadog": {
      "type": "remote",
      "enabled": true,
      "url": "https://mcp.us5.datadoghq.com/v1/mcp",
      "oauth": {},
    },
    "aws": {
      "type": "local",
      "enabled": true,
      "command": [
        "uvx",
        "mcp-proxy-for-aws@latest",
        "https://aws-mcp.us-east-1.api.aws/mcp",
      ],
      "environment": {
        "AWS_REGION": "{env:AWS_REGION}",
      },
    },
    "codegraph": {
      "type": "local",
      "command": ["codegraph", "serve", "--mcp"],
      "enabled": true,
    },
  },
}
