#!/usr/bin/env bash

# functions
#
# useful utility functions
# --------

# Run something n times
#
# Params:
#     n - Number of iterations
#     args - Command and arguments to loop
#
# Usage: loop n args
function loop() {
  for (( n=0; n<$1; n++ )); do
    # shellcheck disable=SC2048
    ${*:2}
  done
}

# Update various dependencies for different languages
#
# Params:
#     none
#
# Usage: update
function update() {
  # node.js
  sudo npm update -g
  yarn global upgrade

  # python
  pip install --upgrade pip
  pip --disable-pip-version-check list --outdated --format=json | python -c "import json, sys; print('\n'.join([x['name'] for x in json.load(sys.stdin)]))" | xargs -n1 pip install -U
  pipx upgrade-all

  # ruby
  gem update

  # rust
  # shellcheck disable=SC2046
  cargo install $(cargo install --list | egrep '^[a-z0-9_-]+ v[0-9.]+:$' | cut -f1 -d' ')

  # go
  # requires go-global-update (see https://github.com/Gelio/go-global-update)
  go-global-update
}

# Convert flac files in current directory to mp3
#
# Params:
#     none
#
# Usage: flac2mp3
function flac2mp3() {
  for f in *.flac; do
    ffmpeg -i "$f" -aq 1 "${f%flac}mp3"
  done
}

# Converts a video file to mp4
#
# Params:
#     infile - Input file
#
# Usage: vid2mp4 input
#
function vid2mp4() {
  usage="usage: vid2mp4 input"

  if [ -z "$1" ]; then
    echo "$usage"
    return 1
  elif command -v ffmpeg &> /dev/null; then
    filename="$(echo "$1" | cut -d . -f 1)"

    ffmpeg -i "$1" -c:v libx264 -crf 23 -c:a aac -q:a 100 "$filename.mp4"

    echo "$1 converted and saved to $2"
  else
    echo "fatal: ffmpeg is not installed"
    return 1
  fi
}

# Cuts out a specific time window from an input video
#
# Params:
#     input - Input file
#     output - Output file name
#     start - Starting timestamp (format: hh:mm:ss)
#     duration - Length to slice, starting at start timestamp
#
# Usage: vidslice input output start duration
#
function vidslice() {
  usage="usage: vidslice input output start duration"

  # check that all args are present, and that input is a file
  if [ -z "$1" ] || [ ! -f "$1" ] || [ -z "$2" ] || [ -z "$3" ] || [ -z "$4" ]; then
    echo "$usage"
    return 1
  elif command -v ffmpeg &> /dev/null; then
    ffmpeg -ss "$3" -t "$4" -i "$1" -vcodec copy -acodec copy "$2"

    echo -e "\n\nsliced $4 from $1, starting at $3, and saved to $2"
  else
    echo "fatal: ffmpeg not installed"
    return 1
  fi
}

# Converts Quicktime screen recording to a gif
#
# Params:
#     infile - Input file (.mov)
#     outfile - Output filename (.gif)
#
# Usage: mov2gif infile outfile
#
function mov2gif() {
  usage="usage: mov2gif input.mov output.gif"

  if [ -z "$1" ] || [ -z "$2" ]; then
    echo "$usage"
    return 1
  elif command -v ffmpeg &> /dev/null && command -v gifsicle &> /dev/null; then
    infile="$1"
    outfile="$2"

    if [ -f "$infile" ]; then
      ffmpeg -hide_banner -loglevel quiet -i "$infile" -s 600x400 -pix_fmt rgb24 -r 10 -f gif - | gifsicle --optimize=3 --delay=3 > "$outfile"

      echo "${infile} converted and saved to ${outfile}"
    else
      echo "fatal: ${infile} is not a file"
      return 1
    fi
  else
    echo "fatal: ffmpeg and gifsicle are not installed"
    return 1
  fi
}

# Create a good tmux setup or attach to an existing one
#
# Params:
#     name - Session name (defaults to "home")
#
# Usage: mux [name]
#
function mux() {
  if [[ -z "$1" ]]; then
    TMUX_SESSION="home"
  else
    TMUX_SESSION="$1"
  fi

  # check if server already running, start a "dummy" session if not
  if ! tmux info &> /dev/null; then
    tmux new -s "_default" -d
  fi

  # set up windows and panes
  if ! tmux has-session -t "$TMUX_SESSION" &> /dev/null; then
    # create session - first window has 3 panes
    tmux new-session -s "$TMUX_SESSION" -n "primary" -d
    tmux split-window -h -t "$TMUX_SESSION:0"
    tmux split-window -v -t "$TMUX_SESSION:0"

    # second window is same as first
    tmux new-window -t "$TMUX_SESSION:1" -n "secondary"
    tmux split-window -h -t "$TMUX_SESSION:1"
    tmux split-window -v -t "$TMUX_SESSION:1"

    # set up vim in full screen window
    tmux new-window -t "$TMUX_SESSION:2" -n "editor"
    tmux send-keys -t "$TMUX_SESSION:2" vim Enter

    # set up 4 equal panes, useful for watching logs
    tmux new-window -t "$TMUX_SESSION:3" -n "logs"
    tmux split-window -h -t "$TMUX_SESSION:3"
    tmux split-window -v -t "$TMUX_SESSION:3.0"
    tmux split-window -v -t "$TMUX_SESSION:3.2"

    # set up logging
    tmux send-keys -t "$TMUX_SESSION:3.0" "journalctl -f" Enter
    tmux send-keys -t "$TMUX_SESSION:3.2" glances Enter
  fi

  # attach to first pane of first window
  tmux attach-session -t "$TMUX_SESSION:0.0"
}

# Repos herd opens a space for, unless --repos says otherwise
#
# Sourced before ~/.exports and ~/.environment, so either can override this.

HERD_REPOS=(
  "$HOME/Code/work/product"
  "$HOME/Code/work/devops"
  "$HOME/Code/personal/larakelley.com"
  "$HOME/Code/personal/git-stk"
  "$HOME/Code/personal/navi"
  "$HOME/Code/personal/dotfiles"
)

# Open herdr with one space per repo, then attach
#
# Tabs and splits come from the default-session plugin, which builds any space
# that has nothing in it yet. Spaces already open are left alone, so this is
# safe to re-run against a live session.
#
# Pass --reset to throw away the saved session first, the way deleting the
# tmux-resurrect folder did. State files are moved aside as .bak, not deleted.
#
# Params:
#     --repos - Repos to open, instead of $HERD_REPOS
#     --reset - Move the saved session aside, then rebuild from scratch
#     --yes   - Skip the reset confirmation
#
# Usage: herd [--repos path ...] [--reset] [--yes]
function herd() {
  local reset=false confirmed=false collecting=false
  local repos=()
  local arg

  for arg in "$@"; do
    case "$arg" in
      --repos)
        collecting=true
        ;;
      --repos=*)
        collecting=false
        IFS=',' read -r -a repos <<< "${arg#--repos=}"
        ;;
      --reset)
        collecting=false
        reset=true
        ;;
      -y | --yes)
        collecting=false
        confirmed=true
        ;;
      -h | --help)
        cat << EOF
usage: herd [--repos path ...] [--reset] [--yes]

Opens a herdr space per repo and attaches. Spaces already open are left alone,
so this is safe to re-run. Tabs, splits, and the programs in them come from the
default-session plugin.

  --repos path ...  Repos to open, instead of \$HERD_REPOS
  --reset           Move the saved session aside as .bak, then rebuild
  -y, --yes         Skip the reset confirmation
  -h, --help        Show this help

Without --repos:
$(printf '  %s\n' "${HERD_REPOS[@]}")
EOF
        return 0
        ;;
      -*)
        echo "fatal: unknown option: $arg"
        echo "usage: herd [--repos path ...] [--reset] [--yes]"
        return 1
        ;;
      *)
        if [[ "$collecting" != true ]]; then
          echo "fatal: pass repos with --repos, as in: herd --repos $arg"
          return 1
        fi

        repos+=("$arg")
        ;;
    esac
  done

  if [[ ${#repos[@]} -eq 0 ]]; then
    repos=("${HERD_REPOS[@]}")
  fi

  if ! command -v herdr &> /dev/null; then
    echo "fatal: herdr must be installed"
    return 1
  fi

  if [[ "$reset" == true ]]; then
    # stopping the server from inside one of its own panes would kill this shell
    if [[ -n "${HERDR_ENV:-}" ]]; then
      echo "fatal: cannot reset from inside herdr, detach first with prefix+q"
      return 1
    fi

    if [[ "$confirmed" != true ]]; then
      local answer

      read -r -p "reset the saved herdr session? every space is rebuilt [y/N] " answer

      if [[ ! "$answer" =~ ^[Yy]$ ]]; then
        echo "left alone"
        return 1
      fi
    fi

    # the server writes the session out as it shuts down, so let it finish
    # before moving anything aside
    herdr server stop &> /dev/null

    local stopping=0

    while herdr status server 2> /dev/null | grep -q "status: running"; do
      sleep 0.2
      stopping=$((stopping + 1))

      if [[ "$stopping" -gt 50 ]]; then
        echo "fatal: herdr server would not stop"
        return 1
      fi
    done

    local state
    for state in "$HOME/.config/herdr/session.json" "$HOME/.config/herdr/session-history.json"; do
      if [[ -f "$state" ]]; then
        mv -f "$state" "$state.bak" && echo "moved aside: $(basename "$state")"
      fi
    done
  fi

  # start the server detached first, the way mux does with tmux, so spaces can
  # be created over the socket api before a client attaches
  if ! herdr status server 2> /dev/null | grep -q "status: running"; then
    (nohup herdr server &> /dev/null &)

    local waited=0

    until herdr status server 2> /dev/null | grep -q "status: running"; do
      sleep 0.2
      waited=$((waited + 1))

      if [[ "$waited" -gt 50 ]]; then
        echo "fatal: herdr server did not start"
        return 1
      fi
    done
  fi

  # a session with no spaces yet only grows one when a client attaches, which is
  # after the repo spaces below — so make the home space first and let it stay
  # the primary space
  if ! herdr workspace list | grep -q '"workspace_id"'; then
    herdr workspace create --cwd "$HOME" --no-focus &> /dev/null && echo "space created: ~"
    sleep 1
  fi

  # the space to land in once the repo spaces exist, normally the ~ one
  local main_space
  main_space="$(herdr workspace list \
    | python3 -c 'import json,sys; w=json.load(sys.stdin)["result"]["workspaces"]; print(next((s["workspace_id"] for s in w if s["focused"]), w[0]["workspace_id"] if w else ""))')"

  local open_spaces
  open_spaces="$(herdr workspace list \
    | python3 -c 'import json,sys; print("\n".join(w["label"] for w in json.load(sys.stdin)["result"]["workspaces"]))')"

  local repo label
  for repo in "${repos[@]}"; do
    if [[ ! -d "$repo" ]]; then
      echo "skipping missing repo: $repo"
      continue
    fi

    label="$(basename "$repo")"

    if grep -qxF "$label" <<< "$open_spaces"; then
      echo "space already open: $label"
      continue
    fi

    if herdr workspace create --cwd "$repo" --label "$label" --no-focus &> /dev/null; then
      echo "space created: $label"
    else
      echo "failed to create space: $label"
    fi
  done

  # spaces are built in the background, so wait for the layouts to settle before
  # claiming focus back from them
  sleep 2

  if [[ -n "$main_space" ]]; then
    herdr workspace focus "$main_space" &> /dev/null
  fi

  # already inside a herdr pane, so the new spaces are all that was needed
  if [[ -n "$HERDR_ENV" ]]; then
    return 0
  fi

  herdr
}

# Completion for herd
#
# Offers flags, then repo paths once --repos is in play: the default list first,
# then ordinary directory completion for anything else.
#
# Params:
#     none (bash completion protocol)
#
# Usage: complete -F _herd herd
function _herd() {
  local current="${COMP_WORDS[COMP_CWORD]}"
  local flags="--repos --reset --yes --help"
  local collecting=false
  local word

  for word in "${COMP_WORDS[@]:1:COMP_CWORD-1}"; do
    case "$word" in
      --repos) collecting=true ;;
      -*) collecting=false ;;
    esac
  done

  COMPREPLY=()

  if [[ "$collecting" != true || "$current" == -* ]]; then
    # shellcheck disable=SC2207
    COMPREPLY=($(compgen -W "$flags" -- "$current"))
    return 0
  fi

  # shellcheck disable=SC2207
  COMPREPLY=($(compgen -W "${HERD_REPOS[*]}" -- "$current"))

  # directory completion only once something is typed, otherwise every directory
  # in the current one buries the repo list
  if [[ -n "$current" ]]; then
    # shellcheck disable=SC2207
    COMPREPLY+=($(compgen -d -- "$current"))
  fi
}

complete -o filenames -F _herd herd

# Starts a Python server, with optional port argument
#
# Params:
#     port - Optional port to serve at (defaults to 8080)
#
# Usage: serve [port]
#
function serve() {
  python -m http.server "${1:-8080}"
}

# Installs peer dependencies for JavaScript projects, using Yarn
#
# Params:
#     package - Package name
#
# Usage: peerdeps package
function peerdeps() {
  local PKG="$1"
  npm info "$PKG@latest" peerDependencies --json | command sed 's/[\{\},]//g ; s/: /@/g' | xargs yarn add --dev "$PKG@latest"
}

# Recursively find and replace text within files in a directory
#
# Params:
#     old - Text to search for
#     new - Replacement text
#
# Usage: sub old new
function sub() {
  usage="usage: sub old new"

  if [ -z "$1" ] || [ -z "$2" ]; then
    echo "$usage"
    return 1
  fi

  if command -v rg &> /dev/null; then
    rg "$1" --files-with-matches | xargs sed -i '' "s/$1/$2/g"
  else
    echo "fatal: ripgrep must be installed"
    return 1
  fi
}

# Print shell escape sequences for Emacs vterm integration
#
# Params:
#     sequence - Escape sequence payload
#
# Usage: vterm_printf sequence
#
# Ref: https://github.com/akermu/emacs-libvterm?tab=readme-ov-file#shell-side-configuration
function vterm_printf() {
    if [ -n "$TMUX" ] \
        && { [ "${TERM%%-*}" = "tmux" ] \
            || [ "${TERM%%-*}" = "screen" ]; }; then
        # Tell tmux to pass the escape sequences through
        printf "\ePtmux;\e\e]%s\007\e\\" "$1"
    elif [ "${TERM%%-*}" = "screen" ]; then
        # GNU screen (screen, screen-256color, screen-256color-bce)
        printf "\eP\e]%s\007\e\\" "$1"
    else
        printf "\e]%s\e\\" "$1"
    fi
}

# Handle unknown commands using PackageKit
#
# Params:
#     args - Command and arguments
#
# Usage: command_not_found_handle args
#
# Copied from /etc/profile.d/PackageKit.sh
function command_not_found_handle() {
  local runcnf=1
  local retval=127

  # only search for the command if we're interactive
  [[ $- == *"i"* ]] || runcnf=0

  # don't run if DBus isn't running
  [[ ! -S /run/dbus/system_bus_socket ]] && runcnf=0

  # don't run if packagekitd doesn't exist in the _system_ root
  [[ ! -x '/usr/libexec/packagekitd' ]] && runcnf=0

  # don't run if bash command completion is being run
  [[ -n ${COMP_CWORD-} ]] && runcnf=0

  # don't run if we've been uninstalled since the shell was launched
  [[ ! -x '/usr/libexec/pk-command-not-found' ]] && runcnf=0

  # run the command, or just print a warning
  if [ $runcnf -eq 1 ]; then
    '/usr/libexec/pk-command-not-found' "$@"
    retval=$?
  elif [[ -n "${BASH_VERSION-}" ]]; then
    printf >&2 'bash: %s%s\n' "${1:+$1: }" "$(gettext PackageKit 'command not found')"
  fi

  # return success or failure
  return $retval
}

# Remove duplicate entries from $PATH
#
# Params:
#     none
#
# Usage: path_dedup
function path_dedup() {
  local old_path="$PATH"
  local new_path=""
  local dir

  while [ -n "$old_path" ]; do
    dir="${old_path%%:*}"

    if [ "$old_path" = "$dir" ]; then
      old_path=""
    else
      old_path="${old_path#*:}"
    fi

    [ -n "$dir" ] || continue

    case ":$new_path:" in
      *":$dir:"*) ;;
      *) new_path="${new_path:+$new_path:}$dir" ;;
    esac
  done

  PATH="$new_path"
}

# Add a directory to the front of $PATH if missing
#
# Params:
#     dir - Directory to prepend
#
# Usage: path_prepend_if_missing dir
function path_prepend_if_missing() {
  local dir="$1"

  [ -n "$dir" ] || return

  case ":$PATH:" in
    *":$dir:"*) ;;
    *) PATH="$dir:$PATH" ;;
  esac
}

# Add a directory to the end of $PATH if missing
#
# Params:
#     dir - Directory to append
#
# Usage: path_append_if_missing dir
function path_append_if_missing() {
  local dir="$1"

  [ -n "$dir" ] || return

  case ":$PATH:" in
    *":$dir:"*) ;;
    *) PATH="$PATH:$dir" ;;
  esac
}

# Switch AWS_PROFILE to work
#
# Usage: aws-work
aws-work() {
  export AWS_PROFILE=work
  export AWS_REGION=us-east-1
  echo "Switched to AWS profile: $AWS_PROFILE"
  aws sts get-caller-identity --query 'Account' --output text
}

# Switch AWS_PROFILE to personal
#
# Usage: aws-personal
aws-personal() {
  export AWS_PROFILE=personal
  export AWS_REGION=us-east-1
  echo "Switched to AWS profile: $AWS_PROFILE"
  aws sts get-caller-identity --query 'Account' --output text
}

# Check current AWS_PROFILE
#
# Usage: aws-current
aws-current() {
  echo "AWS_PROFILE=${AWS_PROFILE:-<unset>}"
  echo "AWS_REGION=${AWS_REGION:-<unset>}"
  aws sts get-caller-identity
}

# Start an LLM harness with seeded AWS credentials
#
# Params:
#   harness - Harness to use (opencode, claude)
#   profile - AWS profile to use (work or personal, optional)
#
# Usage: ai harness [profile]
ai() {
  local harness=$1
  local profile=$2

  case "$harness" in
    claude|opencode) ;;
    *)
      echo "Usage: ai harness [profile]" >&2
      echo "  harness: claude, opencode" >&2
      echo "  profile: work, personal (optional)" >&2
      return 1
      ;;
  esac

  case "$profile" in
    "") ;;
    work) aws-work || return 1 ;;
    personal) aws-personal || return 1 ;;
    *)
      echo "ai: unknown profile '$profile' (expected work or personal)" >&2
      return 1
      ;;
  esac

  command "$harness" "${@:3}"
}
