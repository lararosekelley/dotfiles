{
  "manifest_version": 3,
  "name": "IG Plus",
  "version": "0.10.0",
  "description": "Makes the installed Instagram app present as mobile Safari, so stories can be posted from desktop.",
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://*.instagram.com/*"],
      "js": ["mobile.js", "audience.js", "camera.js"],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": ["https://*.instagram.com/*"],
      "js": ["bridge.js"],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["fonts/Nunito-Variable.ttf"],
      "matches": ["https://*.instagram.com/*"]
    }
  ],
  "oauth2": {
    "client_id": "786075768307-sl90jre7pq31s1vkq6bkosvmkkrhm8bq.apps.googleusercontent.com",
    "scopes": [
      "https://www.googleapis.com/auth/photospicker.mediaitems.readonly"
    ]
  },
  "permissions": ["declarativeNetRequest", "identity"],
  "host_permissions": [
    "https://*.instagram.com/*",
    "https://photospicker.googleapis.com/*",
    "https://*.googleusercontent.com/*"
  ]
}
