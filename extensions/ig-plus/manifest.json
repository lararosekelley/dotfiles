{
  "manifest_version": 3,
  "name": "IG Plus",
  "version": "1.0.0",
  "description": "Posts Instagram stories from desktop, and hides the home feed and Reels.",
  "homepage_url": "https://github.com/lararosekelley/dotfiles/tree/main/extensions/ig-plus",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "key": "",
  "minimum_chrome_version": "140",
  "browser_specific_settings": {
    "gecko": {
      "id": "ig-plus@larakelley.com",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    },
    "gecko_android": {
      "strict_min_version": "140.0"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "IG Plus",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://*.instagram.com/*"],
      "js": ["mobile.js", "audience.js", "camera.js"],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": ["https://*.instagram.com/*"],
      "js": ["bridge.js", "hide.js"],
      "css": ["hide.css"],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["fonts/Nunito-Variable.ttf"],
      "matches": ["https://*.instagram.com/*"]
    }
  ],
  "oauth2": {
    "client_id": "786075768307-sl90jre7pq31s1vkq6bkosvmkkrhm8bq.apps.googleusercontent.com",
    "scopes": [
      "https://www.googleapis.com/auth/photospicker.mediaitems.readonly"
    ]
  },
  "permissions": ["declarativeNetRequest", "identity", "storage"],
  "host_permissions": [
    "https://*.instagram.com/*",
    "https://photospicker.googleapis.com/*",
    "https://*.googleusercontent.com/*"
  ]
}
