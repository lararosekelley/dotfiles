root = true

# shfmt reads its settings from here. Scoped to shell files so other files
# keep each editor's defaults.
[{*.sh,dot_aliases,dot_bash_profile,dot_bash_prompt,dot_bashrc,dot_exports,dot_functions}]
indent_style = space
indent_size = 2
shell_variant = bash
switch_case_indent = true
space_redirects = true
binary_next_line = true

# scripts in home/dot_bin and scripts/setup, and chezmoi modify_ scripts, have no
# extension, nor does system/fans-full
[{home/dot_bin/*,scripts/setup/*,home/**/modify_*,system/fans-full}]
indent_style = space
indent_size = 2
shell_variant = bash
switch_case_indent = true
space_redirects = true
binary_next_line = true
